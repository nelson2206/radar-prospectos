# Clave de la API de Anthropic, desde console.anthropic.com.
# Vive solo en el servidor: nunca la pongas en el HTML ni la subas al repositorio.
ANTHROPIC_API_KEY=sk-ant-...

# Código de acceso compartido con el equipo. Opcional pero muy recomendable:
# sin el, cualquiera con el enlace consume tu saldo de la API.
# Si esta variable no existe, la pagina queda abierta a quien tenga el enlace.
ACCESS_CODE=
